import pandas as pd
import numpy as np

df = pd.read_csv('data.csv')

caloric_values = df['Caloric Value'].values
prices = df['Cena'].values

N = len(df)

hms = 30
max_price = 200

np.random.seed(42)

HM = np.zeros((hms, N), dtype=int)

def fitness(solution):
    total_calories = np.sum(solution * caloric_values)
    total_price = np.sum(solution * prices)

    if total_price > max_price:
        return 0
    return total_calories

for i in range(hms):
    HM[i] = np.random.randint(0, 2, N)

fitness_values = np.zeros(hms)

for i in range(hms):
    fitness_values[i] = fitness(HM[i])

best_index = np.argmax(fitness_values)

print("Best solution:", HM[best_index])
print("Calories:", fitness_values[best_index])
print("Price:", np.sum(HM[best_index] * prices))
